# Copy these values into your hosting provider's Environment Variables.
# DO NOT put real keys in this file or upload them to GitHub.

PORT=3000
GATEWAY_TOKEN=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
DEFAULT_PROVIDER=gemini

# Configure only the providers you want to use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

XAI_API_KEY=
XAI_MODEL=grok-3-mini

COHERE_API_KEY=
COHERE_MODEL=command-a-03-2025
